<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content">

    <LinearLayout
        android:id="@+id/llExpanded"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="end"
        android:background="@drawable/bg_overlay_panel"
        android:padding="8dp">

        <ImageButton
            android:id="@+id/btnToggle"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="@android:color/transparent"
            android:src="@drawable/ic_pause"
            android:contentDescription="Pause/Resume"
            android:tint="@color/vip_gold_light"/>

        <ImageButton
            android:id="@+id/btnClose"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_marginTop="4dp"
            android:background="@android:color/transparent"
            android:src="@drawable/ic_close"
            android:contentDescription="Stop"
            android:tint="@color/error_red"/>

        <ImageButton
            android:id="@+id/btnMinimize"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="4dp"
            android:background="@android:color/transparent"
            android:src="@android:drawable/arrow_down_float"
            android:tint="@color/vip_emerald_light"/>
    </LinearLayout>

    <ImageView
        android:id="@+id/ivMinimized"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:visibility="gone"
        android:src="@drawable/ic_launcher"
        android:background="@drawable/bg_round_blue"
        android:padding="8dp"/>

</FrameLayout>
