<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:paddingStart="4dp"
    android:paddingTop="4dp"
    android:paddingBottom="4dp">

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <!-- Expandable buttons (hidden initially) -->
        <LinearLayout
            android:id="@+id/ovActions"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:visibility="gone"
            android:alpha="0">

            <!-- Pause / Resume button -->
            <ImageButton
                android:id="@+id/btnPause"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="@drawable/bg_overlay_btn_pause"
                android:src="@drawable/ic_overlay_pause"
                android:scaleType="centerInside"
                android:contentDescription="Pause" />

            <!-- Stop button -->
            <ImageButton
                android:id="@+id/btnStop"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_marginStart="8dp"
                android:background="@drawable/bg_overlay_btn_stop"
                android:src="@drawable/ic_overlay_stop"
                android:scaleType="centerInside"
                android:contentDescription="Stop" />
        </LinearLayout>

        <!-- 🟢 Toggle bubble + ring — both perfectly centered -->
        <FrameLayout
            android:layout_width="52dp"
            android:layout_height="52dp"
            android:layout_marginStart="8dp">

            <View
                android:id="@+id/ovPulseRing"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_gravity="center"
                android:background="@drawable/bg_overlay_toggle_ring"
                android:alpha="0.6" />

            <ImageButton
                android:id="@+id/btnToggle"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_gravity="center"
                android:background="@drawable/bg_overlay_toggle_closed"
                android:src="@drawable/ic_overlay_lightning"
                android:scaleType="centerInside"
                android:padding="10dp"
                android:contentDescription="Toggle controls" />
        </FrameLayout>
    </LinearLayout>

</FrameLayout>
