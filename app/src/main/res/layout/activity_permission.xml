<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#121212">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <ImageButton
            android:id="@+id/btnBack"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@drawable/ic_arrow_back"
            app:tint="@android:color/white" />

        <TextView
            android:id="@+id/tvTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="Permission Required"
            android:textColor="@android:color/white"
            android:textSize="24sp"
            android:textStyle="bold" />

        <!-- Permissions List -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:orientation="vertical">

            <!-- Accessibility -->
            <LinearLayout
                android:id="@+id/rowAccessibility"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="?attr/selectableItemBackground"
                android:orientation="horizontal"
                android:padding="12dp">
                <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="Accessibility Service" android:textColor="@android:color/white" android:textSize="16sp"/>
                <TextView android:id="@+id/tvAccessibilityState" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="✘ Tap to enable" android:textColor="#FF5252"/>
            </LinearLayout>

            <!-- Overlay -->
            <LinearLayout
                android:id="@+id/rowOverlay"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="?attr/selectableItemBackground"
                android:orientation="horizontal"
                android:padding="12dp">
                <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="Draw Over Other Apps" android:textColor="@android:color/white" android:textSize="16sp"/>
                <TextView android:id="@+id/tvOverlayState" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="✘ Tap to enable" android:textColor="#FF5252"/>
            </LinearLayout>

            <!-- Battery -->
            <LinearLayout
                android:id="@+id/rowBattery"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="?attr/selectableItemBackground"
                android:orientation="horizontal"
                android:padding="12dp">
                <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="Ignore Battery Optimization" android:textColor="@android:color/white" android:textSize="16sp"/>
                <TextView android:id="@+id/tvBatteryState" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="✘ Tap to enable" android:textColor="#FF5252"/>
            </LinearLayout>
        </LinearLayout>

        <View android:layout_width="match_parent" android:layout_height="1dp" android:layout_marginVertical="16dp" android:background="#333333"/>

        <!-- 🟢 Old Account Method Toggle (Sirf TikTok ke liye) -->
        <LinearLayout
            android:id="@+id/rowOldAccountMethod"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:padding="12dp"
            android:visibility="gone">
            <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="Old Account Method (Skip Flight/Data)" android:textColor="@android:color/white" android:textStyle="bold"/>
            <Switch
                android:id="@+id/switchOldAccountMethod"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"/>
        </LinearLayout>

        <!-- Flight Mode Toggle -->
        <LinearLayout
            android:id="@+id/rowAutoFlight"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:padding="12dp">
            <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="Auto Flight Mode" android:textColor="@android:color/white"/>
            <Switch android:id="@+id/switchAutoFlight" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
        </LinearLayout>

        <!-- ═══════════════════════════════════════════════════════════
             🟢 NEW: Pair with Code (ADB) Toggle + Caption
             ═══════════════════════════════════════════════════════════ -->
        <LinearLayout
            android:id="@+id/rowAdbPairingToggle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:padding="12dp"
            android:gravity="center_vertical">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Pair with Code (ADB)"
                    android:textColor="@android:color/white"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="Auto Flight Mode and Clear Data via ADB"
                    android:textColor="#AAAAAA"
                    android:textSize="12sp" />
            </LinearLayout>

            <Switch
                android:id="@+id/switchAdbPairing"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" />
        </LinearLayout>

        <!-- ═══════════════════════════════════════════════════════════
             🟢 NEW: ADB Pairing Section (visible when toggle ON)
             ═══════════════════════════════════════════════════════════ -->
        <LinearLayout
            android:id="@+id/layoutAdbSection"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:paddingTop="4dp"
            android:paddingBottom="12dp"
            android:visibility="gone">

            <!-- Status text -->
            <TextView
                android:id="@+id/tvAdbStatus"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Not connected"
                android:textColor="#AAAAAA"
                android:textSize="13sp"
                android:layout_marginBottom="8dp" />

            <!-- IP:Pairing Port input -->
            <EditText
                android:id="@+id/etAdbHost"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="IP:Pairing Port (e.g. 192.168.1.5:37755)"
                android:textColor="@android:color/white"
                android:textColorHint="#666666"
                android:textSize="14sp"
                android:background="#1E1E1E"
                android:padding="12dp"
                android:layout_marginBottom="8dp"
                android:inputType="text" />

            <!-- 6-digit pairing code input -->
            <EditText
                android:id="@+id/etCode"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="6-digit pairing code"
                android:textColor="@android:color/white"
                android:textColorHint="#666666"
                android:textSize="14sp"
                android:background="#1E1E1E"
                android:padding="12dp"
                android:layout_marginBottom="8dp"
                android:inputType="number"
                android:maxLength="6" />

            <!-- Pair / Disconnect button -->
            <Button
                android:id="@+id/btnAdbPair"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:text="Pair Now"
                android:backgroundTint="#2196F3"
                android:textColor="@android:color/white"
                android:textAllCaps="false"
                android:layout_marginBottom="8dp" />

            <!-- Help text -->
            <TextView
                android:id="@+id/tvAdbHelp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Settings → Developer options → Wireless debugging ON → 'Pair device with pairing code'. Enter IP:Port and 6-digit code above."
                android:textColor="#666666"
                android:textSize="11sp"
                android:lineSpacingExtra="2dp" />
        </LinearLayout>

        <!-- Captcha Alarm Toggle -->
        <LinearLayout
            android:id="@+id/rowCaptchaAlarm"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:padding="12dp">
            <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="Captcha Alarm" android:textColor="@android:color/white"/>
            <Switch android:id="@+id/switchCaptchaAlarm" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
        </LinearLayout>

        <TextView android:id="@+id/tvSelectedSound" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:paddingStart="12dp" android:text="Default system alarm" android:textColor="#AAAAAA" android:textSize="12sp" />
        <Button android:id="@+id/btnChooseSound" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="12dp" android:layout_marginTop="8dp" android:backgroundTint="#333333" android:text="Choose Sound" android:textColor="@android:color/white" />

        <Button
            android:id="@+id/btnStart"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:layout_marginTop="32dp"
            android:backgroundTint="#4CAF50"
            android:text="Start Automation"
            android:textColor="@android:color/white"
            android:textSize="18sp"
            android:textStyle="bold"
            app:cornerRadius="16dp" />

    </LinearLayout>
</ScrollView>
