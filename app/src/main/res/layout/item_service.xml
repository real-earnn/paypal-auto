<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:padding="14dp"
    android:layout_marginBottom="8dp"
    android:background="@drawable/bg_vip_card"
    android:gravity="center_vertical">

    <TextView
        android:id="@+id/tvServiceName"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:text="PayPal"
        android:textColor="@color/white"
        android:textSize="15sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/tvCountryCount"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="8dp"
        android:text="5 countries"
        android:textColor="@color/vip_emerald_light"
        android:textSize="11sp" />

    <TextView
        android:id="@+id/tvBadge"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_vip_button_gold"
        android:paddingHorizontal="8dp"
        android:paddingVertical="3dp"
        android:text="FREE"
        android:textColor="@color/bg_dark"
        android:textSize="9sp"
        android:textStyle="bold"
        android:visibility="gone" />

</LinearLayout>
